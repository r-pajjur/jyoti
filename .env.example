# ─── Store (Vercel → Storage → any Redis; auto-injected once connected) ───
# A standard redis:// connection string. Works with Redis Cloud, Upstash, or a
# local redis-server — the app speaks plain Redis, not a vendor REST API.
REDIS_URL=redis://default:password@host:6379

# ─── Vercel Blob (photo hosting) ───────────────────────────────────────────
# Auto-injected on Vercel once you connect a Blob store to the project.
# For `vercel dev`, run `vercel env pull .env` to fetch it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Ritual window ─────────────────────────────────────────────────────────
# Day 1 is this date. Everything else counts forward from it.
JYOTI_START_DATE=2026-09-22
JYOTI_TIMEZONE=Asia/Kolkata
JYOTI_TOTAL_DAYS=30
JYOTI_GROUP_SIZE=20
