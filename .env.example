# ─── Store (Vercel → Storage → KV; auto-injected once connected) ──────────
# A direct Upstash store sets UPSTASH_REDIS_REST_* instead — either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Vercel Blob (photo hosting) ───────────────────────────────────────────
# Auto-injected on Vercel once you connect a Blob store to the project.
# For `vercel dev`, run `vercel env pull .env` to fetch it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Ritual window ─────────────────────────────────────────────────────────
# Day 1 is this date. Everything else counts forward from it.
JYOTI_START_DATE=2026-09-22
JYOTI_TIMEZONE=Asia/Kolkata
JYOTI_TOTAL_DAYS=30
JYOTI_GROUP_SIZE=20
