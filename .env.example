# ─── Padlet (server-side only — never expose to the browser) ───────────────
PADLET_API_KEY=pdlt_xxxxxxxxxxxxxxxxxxxxxxxx
PADLET_BOARD_ID=xxxxxxxxxxxxxxxx
PADLET_API_BASE=https://api.padlet.dev/v1

# ─── Vercel Blob (photo hosting; Padlet only accepts attachment URLs) ──────
# Auto-injected on Vercel once you connect a Blob store to the project.
# For `vercel dev` / the test script, run `vercel env pull .env` to fetch it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Ritual window ─────────────────────────────────────────────────────────
# Day 1 is this date. Everything else counts forward from it.
JYOTI_START_DATE=2026-09-22
JYOTI_TIMEZONE=Asia/Kolkata
JYOTI_TOTAL_DAYS=30
JYOTI_GROUP_SIZE=20
