# ─── Store (Vercel → Storage → any Redis; auto-injected once connected) ───
# A standard redis:// connection string. Works with Redis Cloud, Upstash, or a
# local redis-server — the app speaks plain Redis, not a vendor REST API.
REDIS_URL=redis://default:password@host:6379

# ─── Vercel Blob (photo hosting) ───────────────────────────────────────────
# Auto-injected on Vercel once you connect a Blob store to the project.
# For `vercel dev`, run `vercel env pull .env` to fetch it.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ─── Ritual window ─────────────────────────────────────────────────────────
# Day 1 is this date. Everything else counts forward from it.
DHARA_START_DATE=2026-09-19
DHARA_TIMEZONE=America/New_York
DHARA_TOTAL_DAYS=30
DHARA_GROUP_SIZE=20

# ─── Push (generate with `npm run vapid`) ─────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:raghav.pajjur@gmail.com
# Optional. VAPID_PUBLIC_KEY above is used at build time if this is unset.
# On Vercel the PUBLIC_ prefix is reserved for client-readable config and
# cannot be stored as a secret, so setting only VAPID_PUBLIC_KEY is simpler.
PUBLIC_VAPID_PUBLIC_KEY=

# Local hour the morning push may go out (0-23), in DHARA_TIMEZONE. Leave at 0
# when one daily cron does the timing; raise it only with hourly crons.
DHARA_SEND_HOUR=0

# Vercel sets this itself when a cron exists; copy it here for local runs.
CRON_SECRET=
